<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Island.App</RootNamespace>
    <AssemblyName>AgentIslet</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Drawn by scripts/make-icon.ps1. -->
    <ApplicationIcon>Assets\island.ico</ApplicationIcon>
    <!-- WinForms' analyzer wants DPI set in code. This is a WPF app (WinForms is only the tray icon), and
         per-monitor DPI belongs in the manifest, so silence that one rule. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep WPF and WinForms type names from clashing (Application, MessageBox, ...). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also compiled in, for the panel window and the tray icon. -->
    <Resource Include="Assets\island.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Island.Core\Island.Core.csproj" />
    <ProjectReference Include="..\Island.ClaudeCode\Island.ClaudeCode.csproj" />
  </ItemGroup>

</Project>
