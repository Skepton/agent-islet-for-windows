<Window x:Class="Island.App.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Island.App"
        Title="Claude Code Island - panel" Icon="Assets/island.ico" Width="860" Height="580" MinWidth="640" MinHeight="420"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource PanelBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">

    <!-- Our own dark title bar; Windows still handles dragging, snapping and resizing at the edges. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SessionDot" TargetType="Ellipse" BasedOn="{StaticResource StatusDot}">
            <Setter Property="Fill" Value="{StaticResource ScrollThumbBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Attention">
                    <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Working">
                    <Setter Property="Fill" Value="{StaticResource LevelGreenBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Done">
                    <Setter Property="Fill" Value="{StaticResource DoneBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PanelCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
            <Setter Property="Background" Value="{StaticResource PanelCardBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource IslandButton}">
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Padding" Value="4,0" />
        </Style>

        <!-- A waiting permission request inside a session card. -->
        <DataTemplate x:Key="PendingTemplate" DataType="{x:Type local:PendingRow}">
            <StackPanel Margin="17,10,0,0">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource AccentText}" />
                <Border Background="{StaticResource CommandBoxBrush}" CornerRadius="10" Padding="10" Margin="0,6,0,8">
                    <TextBlock Style="{StaticResource MonoCommand}" MaxHeight="72" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding CommandPrefix, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" /><Run Text=" " /><Run Text="{Binding Command, Mode=OneWay}" />
                    </TextBlock>
                </Border>
                <ItemsControl ItemsSource="{Binding Buttons}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Command="{Binding Command}" ToolTip="{Binding Label}"
                                    Style="{StaticResource ActionButtonStyle}" Height="28" MinWidth="70" Margin="0,0,6,6" Padding="10,0" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Content="Answer in terminal" Command="{Binding AnswerInTerminal}" Style="{StaticResource LinkButton}"
                        HorizontalAlignment="Left" Margin="-6,0,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type local:SessionCard}">
            <Border Style="{StaticResource PanelCard}">
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding LastSeen}" Style="{StaticResource SecondaryText}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Chips}" ItemTemplate="{StaticResource ChipTemplate}"
                                      VerticalAlignment="Center" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <Ellipse DockPanel.Dock="Left" Style="{StaticResource SessionDot}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource TitleText}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="{Binding Status}" Style="{StaticResource SecondaryText}" Margin="17,3,0,0" />
                    <TextBlock Text="{Binding Notice}" Style="{StaticResource BodyText}" Margin="17,6,0,0" MaxHeight="84"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding Pendings}" ItemTemplate="{StaticResource PendingTemplate}" Focusable="False" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProjectTemplate" DataType="{x:Type local:ProjectRow}">
            <Border Style="{StaticResource PanelCard}">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Show" Command="{Binding Show}" Style="{StaticResource SmallButton}" Width="64"
                                ToolTip="Show this project's sessions on the island" />
                        <Button Content="Ignore" Command="{Binding Ignore}" Style="{StaticResource SmallButton}" Width="64"
                                ToolTip="Never show this project on the island" />
                        <Button Content="Forget" Command="{Binding Forget}" Style="{StaticResource SmallButton}" Width="64"
                                ToolTip="Ask again the next time this project is used" Margin="0" />
                    </StackPanel>
                    <Border DockPanel.Dock="Right" CornerRadius="9" Padding="8,2" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#2A1614" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsShown}" Value="True">
                                        <Setter Property="Background" Value="#14261A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource LevelRedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsShown}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource DoneBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource TitleText}" />
                        <TextBlock Text="{Binding Path}" Style="{StaticResource SecondaryText}" ToolTip="{Binding Path}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Decided}" Style="{StaticResource SecondaryText}" FontSize="10" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- Maximised windows hang a few pixels past the screen edge; the code-behind pads them back in. -->
    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar: island black, like the popup itself. -->
        <DockPanel Grid.Column="0" Background="{StaticResource IslandBlackBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,16,12,22">
                <Ellipse Style="{StaticResource StatusDot}" />
                <TextBlock Text="Claude Code Island" Style="{StaticResource TitleText}" />
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Margin="18,0,14,16">
                <TextBlock Text="{Binding HooksText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" />
                <TextBlock Text="{Binding Version}" Style="{StaticResource SecondaryText}" FontSize="10" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Margin="10,0">
                <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsSessions}">
                    <DockPanel LastChildFill="True" Width="160">
                        <Border DockPanel.Dock="Right" Style="{StaticResource ChipBorder}" Margin="0"
                                Visibility="{Binding HasSessions, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding SessionCount}" Style="{StaticResource ChipText}" />
                        </Border>
                        <TextBlock Text="Sessions" />
                    </DockPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsProjects}" Content="Projects" />
                <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsUsage}" Content="Usage" />
                <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsDebug}" Content="Debug" />
            </StackPanel>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="24,0,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,6,0,0">
                    <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimise"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CaptionButton}" Click="OnClose" ToolTip="Close"
                            WindowChrome.IsHitTestVisibleInChrome="True" />
                </StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" VerticalAlignment="Bottom" Margin="0,0,0,2" />
            </DockPanel>

            <!-- Sessions -->
            <Grid Grid.Row="1" Visibility="{Binding IsSessions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="No sessions yet. Start Claude Code in a project you chose to show, and it appears here."
                           Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="24,14,24,0"
                           Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,14,18,14">
                    <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionTemplate}" Focusable="False" />
                </ScrollViewer>
            </Grid>

            <!-- Projects -->
            <DockPanel Grid.Row="1" Margin="24,14,18,14" DataContext="{Binding Projects}"
                       Visibility="{Binding DataContext.IsProjects, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <TextBlock DockPanel.Dock="Top" Text="{Binding Explanation}" Style="{StaticResource SecondaryText}"
                           TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ProjectTemplate}" Focusable="False" />
                </ScrollViewer>
            </DockPanel>

            <!-- Usage -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,14,18,14" DataContext="{Binding Usage}"
                          Visibility="{Binding DataContext.IsUsage, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="Your Claude 5-hour and 7-day limits, and a heads-up as you use them up. Off until you turn it on."
                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,14" />

                    <Border Style="{StaticResource PanelCard}">
                        <StackPanel>
                            <CheckBox Style="{StaticResource SwitchToggle}" IsChecked="{Binding Enabled}" Content="Track my Claude usage" />
                            <TextBlock Text="{Binding Consent}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None"
                                       Margin="50,10,0,0" />
                            <TextBlock Text="{Binding Status}" Style="{StaticResource BodyText}" Margin="50,12,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource PanelCard}" IsEnabled="{Binding BarOptionsEnabled}">
                        <StackPanel>
                            <TextBlock Text="When nothing needs you" Style="{StaticResource TitleText}" Margin="0,0,0,12" />
                            <RadioButton Style="{StaticResource ChoiceButton}" IsChecked="{Binding ThinBar}" GroupName="UsageBar">
                                <StackPanel>
                                    <TextBlock Text="A thin bar at the top of the screen" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="One slim gauge per limit. Rest the pointer on it to read the numbers; they also appear for a few seconds whenever they change."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource ChoiceButton}" IsChecked="{Binding OnChangeOnly}" GroupName="UsageBar" Margin="0">
                                <StackPanel>
                                    <TextBlock Text="Only when the numbers change" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="Nothing is drawn until usage moves; then the numbers drop down for a few seconds."
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Debug -->
            <DockPanel Grid.Row="1" Margin="24,14,18,14" Visibility="{Binding IsDebug, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="{Binding UsageText}" Style="{StaticResource BodyText}" />
                    <TextBlock Text="{Binding HooksText}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Copy log" Command="{Binding CopyLog}" Style="{StaticResource SmallButton}" Width="90" />
                        <Button Content="Clear log" Command="{Binding ClearLog}" Style="{StaticResource SmallButton}" Width="90" />
                        <Button Content="Open data folder" Command="{Binding OpenDataFolder}" Style="{StaticResource SmallButton}" Width="130" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Recent events (names only; prompts and commands are never written to disk)"
                           Style="{StaticResource SecondaryText}" Margin="0,0,0,6" />
                <Border Background="{StaticResource IslandBlackBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="10,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Events}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
