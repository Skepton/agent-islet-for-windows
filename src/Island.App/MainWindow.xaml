<Window x:Class="Island.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Island.App"
        Title="Claude Code Island - sessions" Height="640" Width="860"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type local:PermissionRow}">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold">
                        <Run Text="{Binding Session, Mode=OneTime}" />
                        <Run Text=" wants to use " />
                        <Run Text="{Binding Tool, Mode=OneTime}" />
                        <Run Text=" " />
                        <Run Text="{Binding Mode, StringFormat=({0}), Mode=OneTime}" Foreground="Gray" />
                    </TextBlock>
                    <TextBlock Text="{Binding Summary, Mode=OneTime}" TextWrapping="Wrap"
                               FontFamily="Consolas" Margin="0,6,0,8" />
                    <WrapPanel>
                        <Button Content="Allow" Command="{Binding Allow}" Padding="12,3" Margin="0,0,6,6" />
                        <ItemsControl ItemsSource="{Binding Remember}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Command="{Binding Command}" Padding="12,3" Margin="0,0,6,6" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Deny" Command="{Binding Deny}" Padding="12,3" Margin="0,0,6,6" />
                        <Button Content="Answer in terminal" Command="{Binding Terminal}" Padding="12,3" Margin="0,0,6,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" MaxHeight="260" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding UsageText}" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="Permission requests" FontWeight="Bold" Margin="0,0,0,6" />
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Permissions}" />
        </ScrollViewer>

        <TextBlock Grid.Row="3" Text="Sessions" FontWeight="Bold" Margin="0,8,0,6" />
        <ListView Grid.Row="4" ItemsSource="{Binding Sessions}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Session" DisplayMemberBinding="{Binding Name}" Width="170" />
                    <GridViewColumn Header="Phase" DisplayMemberBinding="{Binding Phase}" Width="120" />
                    <GridViewColumn Header="Last event" DisplayMemberBinding="{Binding LastSeen}" Width="90" />
                    <GridViewColumn Header="Notice" DisplayMemberBinding="{Binding Notice}" Width="420" />
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Grid.Row="5" Text="Recent events" FontWeight="Bold" Margin="0,8,0,6" />
        <ListBox Grid.Row="6" ItemsSource="{Binding Events}" FontFamily="Consolas" />
    </Grid>
</Window>
